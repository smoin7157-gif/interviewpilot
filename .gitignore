# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.next-dev.log

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database
/prisma/*.db
/prisma/*.db-journal
/prisma/*.sqlite-backup

# JD seed generation artifacts (the resumable checkpoint is a cache; the
# dataset itself is prisma/seed-data/job-descriptions.json)
/prisma/seed-data/.jd-checkpoint.json
/.jd-run*.log
