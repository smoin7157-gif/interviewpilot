# SQLite database file (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# OpenRouter API key (server-side only — never expose in the browser).
# When unset or failing, InterviewPilot falls back to a built-in question
# bank so the product flow always works.
OPENROUTER_API_KEY=""

# Optional: model id on OpenRouter (default: openai/gpt-4o-mini)
OPENROUTER_MODEL="openai/gpt-4o-mini"
