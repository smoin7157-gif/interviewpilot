# PostgreSQL connection string (Neon serverless Postgres works great with
# Vercel; use the pooled -pooler URL for serverless). Local dev uses the same
# string. Example:
#   postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# OpenRouter API key (server-side only — never expose in the browser).
# When unset or failing, InterviewOS falls back to a built-in question
# bank so the product flow always works.
OPENROUTER_API_KEY=""

# Optional: model id on OpenRouter (default: openai/gpt-4o-mini)
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Optional: cheap/fast model for bulk extraction tasks (resume parsing,
# answer evaluation, follow-up generation). Defaults to OPENROUTER_MODEL.
# Set to a cheaper model to cut AI spend, e.g. "meta-llama/llama-3.1-8b-instruct".
OPENROUTER_CHEAP_MODEL=""

# Optional: GitHub personal access token for authenticated API requests when
# attaching a GitHub profile to an interview. Without it, GitHub allows only
# 60 requests/hour PER IP — on shared hosting the budget is often exhausted
# by other tenants. A fine-grained PAT with "Public repositories (read-only)"
# access is enough (this app only reads public data) and raises the limit to
# 6,000 requests/hour. Generate one at https://github.com/settings/tokens
GITHUB_TOKEN=""

# Canonical URL of the deployed app (e.g. https://interviewos.example.com).
# Used as the metadataBase for Open Graph/social images and as the HTTP-Referer
# sent to OpenRouter. Defaults to http://localhost:3000.
APP_URL=""

# Optional: override the OpenRouter API endpoint (e.g. for a proxy or
# compatible gateway). Defaults to https://openrouter.ai/api/v1.
OPENROUTER_BASE_URL=""
