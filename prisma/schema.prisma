// InterviewOS — V1 schema (PostgreSQL)
// Runs on Neon (serverless Postgres) for Vercel deploys and locally.
// Ownership is enforced at the query layer; RLS policies can be layered on.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions InterviewSession[]
  attempts QuestionAttempt[]
  mocks    MockInterviewSession[]

  @@map("users")
}

model InterviewSession {
  id                  String   @id @default(cuid())
  userId              String
  role                String
  seniority           String
  company             String?
  companyType         String?
  interviewType       String?
  jobDescription      String?
  // Candidate context (Phase 2) — facts only, never invented.
  githubUrl           String?
  githubContext       Json? // { username, repoCount, languages[], topRepos[] }
  resumeFileName      String?
  resumeContext       Json? // { skills[], experience[], projects[], education[], achievements[], certifications[], technologies[] }
  status              String   @default("DRAFT") // DRAFT | READY
  questionCountTarget Int      @default(10)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions InterviewQuestion[]
  projects  CandidateProject[]
  mocks     MockInterviewSession[]

  @@index([userId])
  @@map("interview_sessions")
}

model CandidateProject {
  id            String   @id @default(cuid())
  sessionId     String
  name          String
  repositoryUrl String?
  description   String?
  techStack     String?
  contribution  String?
  createdAt     DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("candidate_projects")
}

model InterviewQuestion {
  id              String   @id @default(cuid())
  sessionId       String
  question        String
  category        String // Technical | Behavioral | Project | Role-specific | General
  difficulty      String // Easy | Medium | Hard
  reason          String
  suggestedAnswer String
  followUps       Json // string[] of follow-up questions
  sourceContext   Json? // string[]: interview_type | job_description | resume | github | project | experience | company | general
  orderIndex      Int
  status          String   @default("NOT_STARTED") // NOT_STARTED | PRACTICED | SKIPPED
  // Written-practice autosave: the answer the user is still typing. Kept
  // separate from QuestionAttempt (which is a submitted, scored answer) so an
  // in-progress draft survives a refresh, crash, or closed tab.
  draftAnswer     String? // null/empty = no draft
  draftSavedAt    DateTime? // last autosave of draftAnswer
  createdAt       DateTime @default(now())

  session  InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attempts QuestionAttempt[]

  @@index([sessionId, orderIndex])
  @@map("interview_questions")
}

model QuestionAttempt {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  prompt     String? // the exact prompt that was practiced (main question or a follow-up)
  answer     String
  score      Int?
  feedback   Json? // { strengths: string[], missing: string[], improvements: string[] }
  createdAt  DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
  @@map("question_attempts")
}

// Phase 3 — AI mock interview (spoken practice).
// A mock rehearses one InterviewSession. Turns hold the full transcript;
// raw audio/video is never stored. overallScore + debrief arrive with Phase 4.
model MockInterviewSession {
  id                 String    @id @default(cuid())
  userId             String
  interviewSessionId String
  status             String    @default("SESSION_STARTED")
  // SESSION_STARTED | QUESTION_COMPLETE | SESSION_COMPLETE | ERROR
  maxQuestions       Int       @default(10)
  overallScore       Int?
  debrief            Json?
  startedAt          DateTime  @default(now())
  endedAt            DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)
  turns   InterviewTurn[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([interviewSessionId, status])
  @@map("mock_interview_sessions")
}

model InterviewTurn {
  id            String   @id @default(cuid())
  mockSessionId String
  turnIndex     Int
  speaker       String // AI | CANDIDATE
  transcript    String
  action        String? // interviewer structured action when speaker=AI
  category      String?
  difficulty    String?
  createdAt     DateTime @default(now())

  mockSession MockInterviewSession @relation(fields: [mockSessionId], references: [id], onDelete: Cascade)

  @@index([mockSessionId, turnIndex])
  @@map("interview_turns")
}
